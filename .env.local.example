# Supabase 配置
# 在 Supabase Dashboard → Settings → API 中获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 服务端管理员密钥，用于 OAuth 用户创建等后台操作
# 在 Supabase Dashboard → Settings → API → service_role key 获取
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 观猹 OAuth 配置
# 由观猹平台分配
GUANCHA_CLIENT_ID=your-guancha-client-id
GUANCHA_CLIENT_SECRET=your-guancha-client-secret

# AI 推荐配置
# 当前默认 provider 为 mock；切换到 remote 时再填写 API 连接信息
AI_RECOMMENDATION_PROVIDER=mock

# 可选：默认 openai
# AI_RECOMMENDATION_API_FORMAT=openai

# 以下字段在 provider=remote 时建议填写
# AI_RECOMMENDATION_BASE_URL=https://your-ai-gateway.example.com
# AI_RECOMMENDATION_API_KEY=your-api-key
# AI_RECOMMENDATION_MODEL_ID=your-model-id

# 以下字段均为可选，代码内有默认值
# path 默认值：openai => /chat/completions，anthropic => /v1/messages
# AI_RECOMMENDATION_PATH=/chat/completions
# AI_RECOMMENDATION_TIMEOUT_MS=30000
# AI_RECOMMENDATION_TEMPERATURE=0.4
# AI_RECOMMENDATION_MAX_TOKENS=800
# AI_RECOMMENDATION_DEFAULT_LIMIT=3
# AI_RECOMMENDATION_API_KEY_HEADER=Authorization

# 邮件通知配置
# provider: "resend" (推荐) 或 "log" (开发模式，仅打印到控制台)
EMAIL_PROVIDER=log
# EMAIL_API_KEY=re_your_resend_api_key
# EMAIL_FROM=LinkClaw <noreply@linkclaw.app>
# EMAIL_REPLY_TO=support@linkclaw.app

# 应用 URL（用于邮件中的链接）
# NEXT_PUBLIC_APP_URL=https://linkclaw.app

# 管理员邮箱白名单（逗号分隔）
# ADMIN_EMAILS=admin@example.com,another@example.com
